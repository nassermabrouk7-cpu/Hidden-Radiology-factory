+import { NextRequest, NextResponse } from "next/server";
+import { createClient } from "@supabase/supabase-js";
+import { generateCampaign, type GeneratedCampaign } from "@/lib/marketing-ai";
+
+export const runtime = "nodejs";
+export const dynamic = "force-dynamic";
+
+function getSupabase() {
+  const url = process.env.NEXT_PUBLIC_SUPABASE_URL;
+  const key = process.env.SUPABASE_SERVICE_ROLE_KEY;
+  if (!url || !key) throw new Error("Supabase environment is not configured");
+  return createClient(url, key, {
+    auth: { persistSession: false, autoRefreshToken: false },
+  });
+}
+
+function authorized(request: NextRequest) {
+  const secret = process.env.CRON_SECRET;
+  const auth = request.headers.get("authorization");
+  return Boolean(secret && auth === `Bearer ${secret}`);
+}
+
+function getSiteUrl() {
+  return (
+    process.env.MARKETING_SITE_URL ||
+    process.env.NEXT_PUBLIC_SITE_URL ||
+    "https://hidden-radiology-project.vercel.app"
+  ).replace(/\/+$/, "");
+}
+
+function validateCampaign(value: GeneratedCampaign) {
+  if (!value || typeof value !== "object") throw new Error("AI campaign is invalid");
+  if (!Array.isArray(value.content) || value.content.length !== 12) {
+    throw new Error("AI campaign must contain exactly 12 content items");
+  }
+
+  for (const item of value.content) {
+    if (!item || typeof item !== "object") throw new Error("AI campaign contains invalid content");
+    if (!["instagram", "facebook", "linkedin"].includes(item.platform)) {
+      throw new Error("AI campaign contains invalid platform");
+    }
+    if (!["ar", "en"].includes(item.language)) {
+      throw new Error("AI campaign contains invalid language");
+    }
+    if (!["authority", "education", "case", "product", "trust", "conversion"].includes(item.content_type)) {
+      throw new Error("AI campaign contains invalid content type");
+    }
+    for (const key of ["title", "hook", "body", "cta"] as const) {
+      if (typeof item[key] !== "string" || !item[key].trim()) {
+        throw new Error(`AI campaign contains empty ${key}`);
+      }
+    }
+    if (!Array.isArray(item.hashtags)) item.hashtags = [];
+  }
+}
+
+export async function POST(request: NextRequest) {
+  if (!authorized(request)) {
+    return NextResponse.json({ error: "Unauthorized" }, { status: 401 });
+  }
+
+  try {
+    const supabase = getSupabase();
+    const url = new URL(request.url);
+    const requestedProductId = url.searchParams.get("product_id");
+
+    const { data: products, error: productError } = await supabase
+      .from("products")
+      .select("id, title_ar, title_en, category, price, language")
+      .order("created_at", { ascending: true })
+      .limit(200);
+
+    if (productError) throw new Error("تعذر قراءة المنتجات التسويقية");
+    if (!products?.length) {
+      return NextResponse.json({ error: "لا توجد منتجات لتوليد حملة" }, { status: 404 });
+    }
+
+    let product = requestedProductId
+      ? products.find((item) => String(item.id) === requestedProductId)
+      : undefined;
+
+    if (!product) {
+      const { data: campaigns, error: campaignError } = await supabase
+        .from("marketing_campaigns")
+        .select("product_id, created_at")
+        .order("created_at", { ascending: false })
+        .limit(500);
+
+      if (campaignError) throw new Error("تعذر قراءة سجل الحملات");
+
+      const latestByProduct = new Map<string, string>();
+      for (const campaign of campaigns || []) {
+        const id = String(campaign.product_id);
+        if (!latestByProduct.has(id)) latestByProduct.set(id, campaign.created_at);
+      }
+
+      product = [...products].sort((a, b) => {
+        const aLast = latestByProduct.get(String(a.id)) || "";
+        const bLast = latestByProduct.get(String(b.id)) || "";
+        if (!aLast && bLast) return -1;
+        if (aLast && !bLast) return 1;
+        return aLast.localeCompare(bLast);
+      })[0];
+    }
+
+    const campaign = await generateCampaign(product);
+    validateCampaign(campaign);
+
+    const { data: insertedCampaign, error: insertCampaignError } = await supabase
+      .from("marketing_campaigns")
+      .insert({
+        product_id: String(product.id),
+        name: campaign.name,
+        objective: campaign.objective,
+        audience: campaign.audience,
+        positioning: campaign.positioning,
+        theme: campaign.theme,
+        language_strategy: campaign.language_strategy,
+        status: "ready",
+        metadata: {
+          generated_by: "openai_responses",
+          model: process.env.MARKETING_AI_MODEL || "gpt-6-luna",
+        },
+      })
+      .select("id")
+      .single();
+
+    if (insertCampaignError || !insertedCampaign) {
+      throw new Error("تعذر حفظ الحملة");
+    }
+
+    const now = new Date();
+    const items = campaign.content.map((item, index) => {
+      const dayOffset = Math.floor(index / 2);
+      const hourUtc = item.language === "ar" ? 6 : 15;
+      const scheduled = new Date(now);
+      scheduled.setUTCDate(scheduled.getUTCDate() + dayOffset);
+      scheduled.setUTCHours(hourUtc, 0, 0, 0);
+
+      return {
+        campaign_id: insertedCampaign.id,
+        product_id: String(product.id),
+        platform: item.platform,
+        language: item.language,
+        content_type: item.content_type,
+        title: item.title,
+        hook: item.hook,
+        body: item.body,
+        cta: item.cta,
+        hashtags: item.hashtags,
+        destination_url: `${getSiteUrl()}/library`,
+        scheduled_at: scheduled.toISOString(),
+        status: "queued",
+        metadata: { sequence: index + 1 },
+      };
+    });
+
+    const { error: insertContentError } = await supabase
+      .from("marketing_content")
+      .insert(items);
+
+    if (insertContentError) throw new Error("تعذر حفظ محتوى الحملة");
+
+    return NextResponse.json({
+      success: true,
+      campaignId: insertedCampaign.id,
+      product: {
+        id: String(product.id),
+        title_ar: product.title_ar,
+        title_en: product.title_en,
+      },
+      contentCount: items.length,
+      status: "queued",
+      message: "تم إنشاء حملة AI ووضعها في طابور النشر",
+    });
+  } catch (error) {
+    console.error("Marketing generation failed:", error);
+    return NextResponse.json(
+      { error: error instanceof Error ? error.message : "Marketing generation failed" },
+      { status: 500 },
+    );
+  }
+}
+
+export async function GET(request: NextRequest) {
+  return POST(request);
+}
