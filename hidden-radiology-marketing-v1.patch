+++ b/src/lib/marketing-ai.ts
@@ -0,0 +1,137 @@
+const OPENAI_RESPONSES_URL = "https://api.openai.com/v1/responses";
+
+type Product = {
+  id: string;
+  title_ar: string;
+  title_en: string;
+  category: string;
+  price: number;
+  language: string;
+};
+
+export type GeneratedCampaign = {
+  name: string;
+  objective: string;
+  audience: string;
+  positioning: string;
+  theme: string;
+  language_strategy: string;
+  content: Array<{
+    platform: "instagram" | "facebook" | "linkedin";
+    language: "ar" | "en";
+    content_type: "authority" | "education" | "case" | "product" | "trust" | "conversion";
+    title: string;
+    hook: string;
+    body: string;
+    cta: string;
+    hashtags: string[];
+  }>;
+};
+
+function getApiKey() {
+  const key = process.env.OPENAI_API_KEY;
+  if (!key) throw new Error("OPENAI_API_KEY is not configured");
+  return key;
+}
+
+function getModel() {
+  return process.env.MARKETING_AI_MODEL || "gpt-6-luna";
+}
+
+function extractOutputText(response: unknown) {
+  const output = (response as { output?: unknown[] })?.output;
+  if (!Array.isArray(output)) return "";
+
+  const chunks: string[] = [];
+  for (const item of output) {
+    if (!item || typeof item !== "object") continue;
+    const content = (item as { content?: unknown[] }).content;
+    if (!Array.isArray(content)) continue;
+    for (const part of content) {
+      if (!part || typeof part !== "object") continue;
+      const text = (part as { text?: unknown }).text;
+      if (typeof text === "string") chunks.push(text);
+    }
+  }
+  return chunks.join("\n").trim();
+}
+
+function parseJson<T>(text: string): T {
+  const cleaned = text
+    .replace(/^```json\s*/i, "")
+    .replace(/^```\s*/i, "")
+    .replace(/\s*```$/i, "")
+    .trim();
+
+  try {
+    return JSON.parse(cleaned) as T;
+  } catch {
+    const start = cleaned.indexOf("{");
+    const end = cleaned.lastIndexOf("}");
+    if (start < 0 || end <= start) throw new Error("AI returned invalid JSON");
+    return JSON.parse(cleaned.slice(start, end + 1)) as T;
+  }
+}
+
+export async function generateCampaign(product: Product): Promise<GeneratedCampaign> {
+  const systemPrompt = `
+You are the senior marketing strategist for Hidden Radiology, a specialized radiology education brand.
+The brand sells educational books and also offers lessons, courses, and clinical cases.
+The goal is authority, trust, education, and sustainable conversion — never spammy "buy now" content.
+Medical content must remain educational and cautious. Do not invent clinical claims, statistics, diagnoses, or guideline recommendations.
+Do not imply guaranteed outcomes.
+Generate concise social content suitable for Instagram, Facebook, and LinkedIn.
+Create a bilingual campaign: Arabic for MENA learners and English for the global radiology audience.
+Use a professional, academic, modern tone.
+Return ONLY valid JSON matching the requested structure.
+`;
+
+  const userPrompt = `
+Product:
+${JSON.stringify(product)}
+
+Create one campaign with exactly 12 content items:
+- 4 authority items
+- 3 education items
+- 2 trust items
+- 2 product/conversion items
+- 1 case-style item
+For each of the 6 core ideas, create one Arabic and one English version.
+Distribute platforms naturally among Instagram, Facebook, and LinkedIn.
+Use one clear idea per item.
+The product must be presented as a reference/resource, not as a medical authority.
+`;
+
+  const response = await fetch(OPENAI_RESPONSES_URL, {
+    method: "POST",
+    headers: {
+      "Content-Type": "application/json",
+      Authorization: `Bearer ${getApiKey()}`,
+    },
+    body: JSON.stringify({
+      model: getModel(),
+      input: [
+        { role: "developer", content: systemPrompt },
+        { role: "user", content: userPrompt },
+      ],
+      max_output_tokens: 6000,
+    }),
+  });
+
+  const raw = await response.text();
+  if (!response.ok) {
+    console.error("OpenAI marketing request failed:", response.status, raw.slice(0, 500));
+    throw new Error(`OpenAI request failed (${response.status})`);
+  }
+
+  let payload: unknown;
+  try {
+    payload = JSON.parse(raw);
+  } catch {
+    throw new Error("OpenAI returned invalid response");
+  }
+
+  const outputText = extractOutputText(payload);
+  if (!outputText) throw new Error("OpenAI returned empty output");
+  return parseJson<GeneratedCampaign>(outputText);
+}
diff --git a/src/app/api/marketing/generate/route.ts b/src/app/api/marketing/generate/route.ts
